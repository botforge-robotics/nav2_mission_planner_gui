rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }

    function isOwner(accountId) { return request.auth.uid == accountId; }

    // Account management - users can only read their own account data
    match /accounts/{accountId} {
      allow read: if isSignedIn() && isOwner(accountId);
      allow write: if false; // All writes go through Cloud Functions
    }

    // Device management - users can only read their own device data
    match /devices/{deviceId} {
      allow read: if isSignedIn() &&
        resource.data.accountId == request.auth.uid;
      allow write: if false; // All writes go through Cloud Functions
    }

    // Payment tracking - users can only read their own payment records
    match /payments/{paymentId} {
      allow read: if isSignedIn() &&
        resource.data.accountId == request.auth.uid;
      allow write: if false; // All writes go through Cloud Functions
    }

    // Legacy purchases collection - deprecated, no access
    match /purchases/{purchaseId} {
      allow read, write: if false;
    }

    // Enterprise branding - read-only for authenticated users
    match /enterprises/{enterpriseId} {
      allow read: if isSignedIn();
      allow write: if false; // All writes go through Cloud Functions
    }

    // Audit trail - users can only read their own audit entries
    match /audit/{auditId} {
      allow read: if isSignedIn() &&
        resource.data.accountId == request.auth.uid;
      allow write: if false; // All writes go through Cloud Functions
    }

    // Public read-only pricing doc for website
    match /plans/{planId} {
      allow read: if planId == "current"; // publicly readable
      allow write: if false;
    }

    // default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
